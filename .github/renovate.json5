{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
    ':configMigration',
  ],
  schedule: [
    'at any time',
  ],
  labels: [
    'dependency',
  ],
  pinDigests: true,
  prCreation: 'not-pending',
  minimumReleaseAgeBehaviour: 'timestamp-optional',
  minimumReleaseAge: '3 days',
  internalChecksFilter: 'strict',
  osvVulnerabilityAlerts: true,
  vulnerabilityAlerts: {
    enabled: true,
  },
  dependencyDashboard: {
    enabled: true,
    osvVulnerabilitySummary: 'all',
  },
  timezone: 'Australia/Brisbane',
  prConcurrentLimit: 5,
  ignoreUnstable: true,
  respectLatest: true,
  packageRules: [
    {
      description: 'github-actions: group minor+patch together, run weekly',
      matchManagers: [
        'github-actions',
      ],
      matchUpdateTypes: [
        'minor',
        'patch',
      ],
      groupName: 'actions dependencies',
      groupSlug: 'actions-dependencies',
      commitMessageTopic: 'github-actions {{updateType}} dependencies',
      schedule: [
        'before 8am on monday',
      ],
    },
    {
      description: 'Automerge anything that is NOT a major update',
      matchUpdateTypes: [
        'minor',
        'patch',
        'pin',
        'digest',
        'pinDigest',
      ],
      automerge: true,
      platformAutomerge: true,
    },
    {
      description: 'Label major updates',
      matchUpdateTypes: [
        'major',
      ],
      addLabels: [
        'semver:major',
      ],
    },
    {
      description: 'Label minor updates',
      matchUpdateTypes: [
        'minor',
      ],
      addLabels: [
        'semver:minor',
      ],
    },
    {
      description: 'Label patch updates',
      matchUpdateTypes: [
        'patch',
      ],
      addLabels: [
        'semver:patch',
      ],
    },
    {
      description: 'Label pin and digest updates',
      matchUpdateTypes: [
        'pin',
        'digest',
        'pinDigest',
      ],
      addLabels: [
        'semver:none',
      ],
    },
  ],
}
